# Copy to .env.local for local development, and add the same values in your host's
# environment settings (e.g. Vercel → Project → Settings → Environment Variables).

# Production URL, no trailing slash. Enables canonical URLs, sitemap and search indexing.
# Leave unset on preview deployments so they stay out of search engines.
NEXT_PUBLIC_SITE_URL=

# Enquiry delivery to hello@praxera.in. RECOMMENDED: Web3Forms.
# Get a free key at https://web3forms.com by entering hello@praxera.in — the key is emailed to you.
# It is a public key by design (it can only send to that inbox), so NEXT_PUBLIC_ is fine.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Alternatively, set both Resend values below. With neither set, the form sends directly
# through FormSubmit (no key; one-time activation email to hello@praxera.in). If sending
# fails, visitors are offered "Send on WhatsApp" / "Send by email" with the enquiry pre-written.
RESEND_API_KEY=
# Optional. Where enquiries are delivered; defaults to hello@praxera.in. Comma-separate for several.
ENQUIRY_TO_EMAIL=
# Sender. Must be on a domain verified in Resend, e.g. "Praxera Technologies <enquiries@praxera.in>".
# For testing only, "Praxera <onboarding@resend.dev>" works but can only deliver to your Resend account email.
ENQUIRY_FROM_EMAIL=
